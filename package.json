{
  "name": "rafd-wind",
  "version": "0.1.0",
  "description": "رفد Desktop — نظام نقاط بيع ومحاسبة يعمل بدون إنترنت 100% (Windows/Electron)",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "keygen": "node tools/keygen/sign-license.mjs",
    "package:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
